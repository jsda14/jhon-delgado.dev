    "category": {
      "type": "enumeration",
      "required": false,
      "default": "frontend",
      "enum": [
        "frontend",
        "backend-ai",
        "cloud",
        "practices"
      ]
    },
    "level": {
      "type": "integer",
      "required": true,
      "default": 90
    },
    "iconName": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 1
    }
  }
}
